{"\u0072\u0076\u0074\u0074\u006b\u005f\u0063\u0061\u0061":"\u0065\u002e\u0072\u0069\u0067\u0076\u0069\u005f\u0069\u005f\u0062\u0061\u0073\u006c\u0075\u0061\u006e\u0072\u0073\u0076"}]},"\u0063\u0061\u005f\u0072\u0074\u0074\u0076\u0061\u006b":{"\u0074\u0069\u006e\u0073\u006f\u0061\u0061\u006e\u006d\u0069":["first_person_vr_attack_rotation"],"\u006f\u0061\u0074\u0073\u0069\u0069\u0074\u0072\u006e\u006e\u0073":[{"\u0066\u0065\u0074\u0075\u0064\u0061\u006c":"\u0021\u0076\u0072\u0076\u0065\u005f\u0061\u0073\u0069\u002e\u0067\u0073\u005f\u006c\u0069\u0072\u0061\u006e\u0062\u0075\u0069"}]}}},"\u0065\u006c\u006e\u0074\u0063\u0073\u006f\u0070\u0072\u002e\u002e\u0061\u006e\u006d\u0072\u006c\u005f\u0070\u0072\u0061\u0074\u0069\u005f\u0070\u0069\u0065\u006e\u002e\u0061\u006e\u0074\u0072\u0065\u006f\u006c\u0072\u006d\u0073\u0066\u0069\u0079\u006f\u0061\u006f":{"\u0061\u0069\u0061\u0074\u0074\u0073\u0074\u006e\u005f\u0065\u0069\u0069\u006c":"\u0061\u0064\u0075\u0065\u0066\u006c\u0074","\u0073\u0074\u0073\u0074\u0061\u0065":{"\u0061\u0065\u0064\u0075\u0074\u0066\u006c":{"\u0074\u0061\u006f\u0069\u0072\u0069\u0074\u006e\u0073\u006e\u0073":[{"\u0064\u006e\u005f\u0065\u0061\u006e\u006f\u0068":"\u002e\u002e\u0067\u0020\u0065\u005f\u0027\u0065\u0074\u0073\u0020\u005f\u0061\u006e\u0061\u0070\u0068\u0065\u0070\u003d\u0065\u005f\u006d\u0020\u006f\u0027\u0028\u006e\u0027\u0074\u0071\u007c\u0068\u0064\u006d\u0065\u0066\u0075\u0064\u0065\u0020\u003d\u0028\u0066\u0075\u005f\u0069\u006c\u0071\u005f\u0069\u005f\u0070\u0061\u0064\u006f\u0065\u006e\u0069\u0065\u0070\u0068\u0027\u0065\u0074\u0069\u006c\u006d\u0067\u0066\u0064\u007c\u0029\u0065\u0071\u006e\u0027\u0064\u0061\u0069\u0069\u0065\u005f\u003d\u0020\u005f\u0027\u0071\u0066\u0074\u0020\u0027\u0061\u006c\u0070\u006d\u0027\u0064\u0029\u0066\u0065\u003d\u005f\u006d"},{"\u0077\u0064\u0068\u006e\u0061\u0074\u006f\u005f":"\u0027\u0027\u0068\u005f\u006f\u0071\u0065\u0065\u0075\u0027\u0064\u005f\u0065\u0027\u003d\u006e\u002e\u0064\u0065\u006e\u0070\u0027\u0020\u006d\u0027\u006d\u005f\u0061\u0021\u0065\u0064\u0067\u005f\u0027\u0020\u006c\u0069\u0071\u0020\u0066\u0028\u006e\u0061\u0070\u005f\u003d\u006c\u0073\u0020\u0074\u006c\u0026\u0029\u0027\u0065\u002e\u0021\u0065\u0074\u006d\u0069\u0066\u0064\u0071\u0061\u0065\u0071\u006d\u0067\u0069\u0026\u006d\u0066\u0068\u0074\u0069\u0075\u0066\u0069\u005f\u005f\u0070\u0074\u0069\u0061\u0065\u0028\u0065\u0065\u006e\u006f\u0070\u0064\u0061\u005f\u0070\u0029\u0068\u0065\u0020\u005f\u0020\u0066\u0064"}]},"\u0068\u005f\u006e\u0065\u0064\u0061\u006e\u006f":{"\u0061\u0074\u006d\u006f\u0061\u006e\u006e\u0069\u0073\u0069":[{"\u0065\u0061\u006f\u006e\u005f\u0068\u0061\u0061\u0074\u0073\u0070\u0072\u006c\u0072\u0064\u006e\u0064\u005f\u005f\u006d\u0070\u0068\u0073\u0069\u0069\u006f\u0066\u005f\u006d\u005f\u006e":"\u006d\u002c\u0070\u0075\u0020\u0027\u005f\u0030\u0065\u0065\u0064\u0074\u0029\u005f\u0065\u0065\u0070\u0071\u0061\u0031\u0020\u0070\u0074\u0065\u0069\u0027\u0061\u006d\u0028\u0066\u006e\u003d\u0067\u005f\u003d\u006c\u005f\u002e\u0065\u0071\u0069\u006c\u0020\u0069\u006d\u0064"},{"\u005f\u0064\u0072\u0069\u0061\u006f\u006d\u005f\u0072\u005f\u005f\u0073\u006f\u0066\u0068\u0066\u0070\u0073\u0074\u0064\u006f\u0066\u006c\u0061\u0070\u006e\u006e\u0068\u005f\u0065":"\u0061\u0065\u006c\u003d\u0070\u0069\u006e\u0067\u0070\u0074\u0074\u0071\u0066\u0026\u0071\u003d\u0069\u0064\u005f\u006f\u005f\u005f\u002e\u0065\u0064\u005f\u0028\u0075\u006e\u0065\u0069\u0069\u0062\u0065\u0075\u0072\u0072\u0020\u0061\u0020\u0074\u0020\u005f\u0064\u006c\u0065\u007a\u007a\u006c\u003e\u0064\u0077\u0074\u0065\u0061\u0029\u0065\u0065\u0020\u0027\u0027\u0029\u006f\u0065\u0073\u0076\u0030\u0074\u0074\u0020\u0026\u006c\u006f\u0061\u0061\u0065\u006c\u0069\u0061\u0020\u0069\u0028\u0070\u003d\u005f\u0062\u0065\u0062\u0029\u002e\u006d\u0020\u0020\u0065\u006d\u0061\u0069\u0072\u0075\u0066\u0065\u0030\u005f\u0027\u0064\u0064\u0070\u003d\u0020\u0020\u006f\u003f\u006d\u006e\u0020\u0076\u0028\u0069\u0061\u006e\u005f\u0027\u0020\u005f\u0069\u0065\u0071\u005f\u0065\u006d\u0066\u0027\u0061\u006d\u0068\u0069\u0067\u0020\u005f\u006d\u003c\u0065\u0027\u002e\u006e\u006c\u0021\u0031\u0065\u0075\u005f\u0065\u006d\u0069\u0020\u006d\u0071\u003a\u0031\u002e\u0026\u0020\u0061\u0030\u0073\u0065\u002e\u0072\u0070\u002e\u006d\u0020\u0026"}],"\u0069\u0074\u006f\u0069\u0073\u0074\u0072\u0061\u006e\u0073\u006e":[{"\u0065\u0075\u006c\u0074\u0064\u0066\u0061":"\u0066\u0070\u0071\u0026\u003d\u0071\u0069\u0021\u0070\u0069\u006d\u0061\u0027\u0027\u0029\u002e\u0020\u005f\u0065\u0028\u006c\u0065\u0074\u0061\u005f\u0061\u0061\u0064\u0026\u005f\u006d\u002e\u0027\u0020\u0065\u0065\u0069\u0020\u0064\u005f\u0074\u005f\u0074\u0065\u006d\u006c\u006c\u0069\u002c\u006d\u005f\u006e\u0075\u006d\u0065\u0064\u0020\u0064\u0070\u0070\u0030\u0069\u0067\u0067\u0068\u006f\u0020\u0065\u006e\u0065\u0020\u0065\u0031\u0071\u0066\u003d\u0066\u0061\u0029\u0021\u006e\u0064\u0027\u0066\u0074\u006c\u005f\u0070\u0027\u0071\u0070\u006d\u0075\u0065\u0020\u005f\u0028\u005f\u0027\u0065\u0065\u0069"},{"\u0074\u0064\u0061\u006e\u006f\u0077\u005f\u0068":"\u006f\u0068\u0066\u0027\u0020\u0075\u0020\u0020\u0020\u0070\u006d\u0071\u005f\u0027\u0027\u005f\u006c\u0026\u0066\u0065\u006e\u0066\u006e\u0065\u0065\u006d\u005f\u0064\u0028\u0065\u002e\u0061\u0065\u0075\u0064\u006e\u005f\u0070\u0061\u0064\u0068\u0069\u0070\u005f\u0061\u0020\u0064\u0064\u0069\u0071\u0065\u002e\u0061\u0065\u0027\u0074\u0029\u0065\u0069\u006c\u006d\u0061\u0021\u0069\u0028\u0070\u0071\u006d\u003d\u005f\u0065\u005f\u0027\u0065\u006c\u0074\u0070\u0027\u005f\u0066\u006e\u0071\u0074\u0064\u0029\u0066\u0067\u0027\u0068\u003d\u006d\u0021\u0065\u0074\u0073\u0020\u006f\u0027\u0026\u0067\u0065\u005f\u0069\u0069"}]},"\u0064\u0068\u006f\u0077\u0074\u0061\u005f\u006e":{"\u006d\u0069\u0061\u006e\u006e\u006f\u0074\u0073\u0069\u0061":["first_person_map_hold","first_person_map_hold_attack"],"\u0069\u006e\u0073\u006e\u0074\u0072\u0073\u0061\u006f\u0069\u0074":[{"\u0061\u0065\u006c\u0075\u0066\u0074\u0064":"\u0061\u0074\u002e\u0027\u0071\u0065\u0069\u005f\u0061\u002c\u006c\u0071\u0021\u0064\u005f\u006e\u006d\u002e\u0069\u0027\u006d\u0061\u006d\u006e\u005f\u006d\u0061\u0064\u0066\u0066\u0020\u0064\u0067\u0065\u0065\u0069\u006d\u0031\u0075\u0070\u0066\u0028\u0070\u003d\u0064\u0029\u006c\u006d\u0066\u005f\u0021\u0067\u0030\u0065\u0027\u0061\u0020\u0065\u0020\u0069\u005f\u0070\u006c\u0065\u0074\u006e\u005f\u0027\u0065\u0070\u0027\u0065\u0071\u005f\u006c\u0068\u0070\u0069\u0070\u0026\u0071\u005f\u0065\u005f\u0074\u0069\u0027\u0075\u006f\u0028\u0026\u0064\u0020\u0020\u0020\u0029\u0020\u0065\u003d\u0065\u0074\u0065"},{"\u0068\u006e\u0064\u005f\u0065\u0061\u006e\u006f":"\u0071\u0061\u006e\u005f\u005f\u0065\u0067\u007c\u0065\u0029\u006e\u006c\u0068\u0064\u0068\u0065\u005f\u006d\u005f\u0069\u0020\u006e\u005f\u0066\u0061\u0070\u006d\u005f\u0071\u0066\u0028\u0069\u0070\u0073\u0066\u0067\u003d\u003d\u006c\u0065\u0070\u0066\u0027\u0065\u006d\u0027\u0069\u0020\u0027\u0027\u002e\u005f\u0027\u0074\u006e\u0064\u006f\u0061\u0071\u0069\u0065\u0065\u006f\u005f\u0064\u0069\u0064\u002e\u0070\u0074\u0020\u0065\u0065\u0069\u0070\u0064\u0027\u0020\u0074\u0065\u0027\u0075\u003d\u0071\u0027\u0064\u0061\u006d\u0075\u0028\u0029\u0020\u0074\u0020\u0068\u0065\u0061\u005f\u0066\u006c\u0065\u007c\u003d\u006d"}]}}},"\u006f\u0066\u0061\u006c\u006d\u005f\u0069\u006f\u0065\u006f\u0065\u0070\u0061\u0072\u006d\u005f\u0074\u0079\u0063\u006f\u0065\u005f\u0069\u002e\u006e\u006c\u0072\u006c\u0065\u006c\u0072\u0073\u006e\u0065\u006e\u0074\u002e\u0070\u0073\u0072\u002e\u0070\u0065\u0061\u006e\u0072\u0069\u0065\u0074\u0073\u0061\u0072":{"\u0074\u005f\u006e\u0069\u0065\u0069\u0074\u0061\u0069\u0061\u0073\u006c\u0074":"\u0068\u006f\u0064\u006c","\u0073\u0061\u0074\u0074\u0073\u0065":{"\u0064\u0068\u006f\u006c":{"\u0069\u0074\u0061\u006e\u006d\u006f\u0073\u0069\u006e\u0061":["first_person_melee_spear_hold"],"\u006e\u0061\u0069\u0072\u0074\u006f\u0073\u0074\u0069\u006e\u0073":[{"\u0075\u0073\u0065":"\u0020\u006f\u006d\u0030\u0065\u006c\u0064\u002e\u0065\u0072\u0076\u0061\u002e\u0020\u0061\u0072\u0069\u003e\u0069\u0061\u0073\u007a\u005f\u005f\u0069\u006e\u006c\u0030\u0074\u0062\u0065\u006d\u0065\u0075"},{"\u0074\u0061\u0063\u0061\u0074\u006b":"\u0061\u0065\u0020\u0074\u0062\u002e\u0030\u0074\u003e\u006d\u0061\u0069\u0065\u0063\u0076\u005f\u0072\u002e\u0020\u006c\u0069\u0061\u0030\u0074\u0061\u006b"}]},"\u0065\u0073\u0075":{"\u0061\u006f\u0069\u0069\u0073\u006e\u0074\u0061\u006d\u006e":["first_person_melee_spear_use"],"\u006e\u0069\u0069\u006f\u0073\u0061\u006e\u0072\u0073\u0074\u0074":[{"\u006c\u0064\u006f\u0068":"\u0069\u0020\u0075\u0076\u006d\u0061\u0062\u006c\u0065\u0065\u005f\u0069\u006e\u005f\u0072\u0061\u0074\u0072\u006c\u0065\u0020\u006f\u0065\u0030\u006d\u007a\u002e\u0069\u003d\u003d\u0073\u0064\u002e\u0030\u0061"}]},"\u006b\u0061\u0074\u0074\u0061\u0063":{"\u0061\u006e\u0061\u006e\u0073\u0069\u006f\u006d\u0074\u0069":["first_person_melee_spear_attack"],"\u0072\u0073\u0069\u006e\u006f\u0073\u006e\u0069\u0074\u0074\u0061":[{"\u0064\u006c\u0068\u006f":"\u003d\u0061\u006d\u002e\u0074\u0062\u0076\u0030\u006b\u0030\u0061\u0072\u0061\u0069\u003d\u0063\u0074\u006c\u0065\u0020\u0020\u0069\u0061\u005f\u0074\u0065\u002e"},{"\u0075\u0065\u0073":"\u003e\u0061\u0076\u006c\u0069\u006e\u0065\u0074\u006d\u002e\u002e\u0072\u0062\u006f\u0065\u0065\u006d\u005f\u0061\u005f\u0072\u0020\u0064\u0075\u0069\u0020\u0030\u006c\u0030\u0061\u0073\u0065\u007a\u0069"}],"\u0073\u0064\u0069\u0072\u006e\u0069\u0061\u0062\u006f\u0065\u005f\u006e\u006c\u0074\u006e\u0074":"\u0030\u002e\u0032","\u0070\u0068\u0074\u006e\u005f\u0074\u006c\u0064\u0069\u0076\u0073\u0061\u0068\u005f\u0074\u0062\u005f\u006f\u0061\u0065\u0073\u0065\u0072":"\u0072\u0074\u0065\u0075"}}},"\u006f\u0072\u0061\u0065\u0069\u0074\u0074\u0074\u0070\u0079\u0063\u006f\u006c\u002e\u006f\u0061\u0072\u002e\u006e\u006f\u006e\u0072\u006f\u006d\u006e\u0065\u0061\u0072\u0069\u002e\u006c\u006c":{"\u0073\u005f\u006c\u0061\u0069\u0074\u0074\u0069\u006e\u0065\u0069\u0074\u0061":"\u0066\u0065\u0073\u0074\u0070\u005f\u006e\u0069\u0072\u0073\u0072\u006f","\u0061\u0073\u0073\u0074\u0065\u0074":{"\u0069\u0065\u006f\u005f\u0072\u0066\u0074\u0073\u0073\u0070\u0072\u006e":{"\u0061\u006f\u0069\u006e\u006e\u0069\u0073\u0061\u006d\u0074":["first_person_base_pose","move.legs",{"\u005f\u0072\u0074\u0070\u0062\u0069\u0074\u0061\u0065\u0068\u0065\u0067\u0069\u0072\u0072\u006e\u005f\u0066\u0073\u006f\u006f\u0062\u006e\u005f\u0062\u0073":"\u0070\u006e\u006e\u0072\u0076\u0066\u0065\u0072\u002e\u006e\u005f\u0065\u006f\u0074\u0069\u0067\u0064"},{"\u0069\u0070\u0065\u0069\u006f\u0073\u005f\u0073\u0074\u005f\u006d\u0065\u0072\u0061\u006e\u0077\u0070\u0074\u0072\u0066\u0073\u005f":"\u0021\u0071\u002e\u0072\u0065\u0062\u0064\u006c\u006b\u006f\u0020\u0065\u006f\u0026\u0069\u0020\u006e\u006e\u006e\u0070\u0067\u0076\u0063\u0074\u0026\u0072\u002e\u005f\u0067\u0069\u0066\u006e"},{"\u006f\u0074\u0073\u0072\u0065\u0073\u0069\u005f\u005f\u006f\u006c\u0069\u005f\u006e\u0068\u0062\u0064\u006c\u0072\u0063\u0070\u006b\u0066\u0065\u0073":"\u006b\u0063\u0067\u006e\u0062\u0069\u006c\u002e\u006f\u0071"},{"\u006f\u0069\u0074\u0066\u0073\u0065\u0072\u0070\u006c\u005f\u006f\u0063\u0061\u0061\u0065\u0072\u006f\u0063\u0072\u005f\u006b\u005f\u006e\u0072\u0074\u006c\u006e\u0074\u0073\u0074":"\u006d\u0074\u0074\u0070\u0065\u0071\u006e\u0065\u0076\u002e\u0027\u0061\u0061\u003d\u0020\u0020\u0065\u0065\u006c\u0061\u0020\u0070\u0027\u0026\u0069\u0026\u0027\u0072\u002e\u0063\u003d\u006f\u0070\u006c\u0065\u0072\u005f\u0029\u0070\u006c\u0074\u0069\u0075\u0061\u0072\u0020\u0021\u0063\u0074\u006b\u006f\u0020\u0027\u0071\u0030\u0020\u005f\u0061\u0072\u006d\u0030\u0065\u0065\u0065\u006d\u0070\u005f\u0065\u0065\u0072\u0065\u002e\u0072\u0069\u0071\u0072\u0073\u0020\u0061\u006c\u002e\u0072\u0061\u0075\u0069\u0065\u006c\u0069\u0020\u0069\u0020\u0021\u0061\u0074\u005f\u0064\u0065\u0069\u0067\u0069\u0073\u0061\u0065\u0067\u0062\u0070\u0063\u0063\u0074\u0065\u00