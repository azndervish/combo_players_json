\u0065\u0069\u0075\u0067\u0075\u0030\u002e\u0069\u006e\u006e\u006d\u0030\u0020\u005f\u0074\u0020\u0071\u0069\u0072\u0061\u002e\u005f\u005f\u0065\u0064"}]},"\u0064\u006c\u006f\u0068":{"\u0061\u0061\u0069\u0074\u006d\u006f\u0069\u0073\u006e\u006e":["crossbow_hold"],"\u0074\u0074\u0069\u006e\u0073\u006e\u0072\u0073\u0069\u006f\u0061":[{"\u0075\u0061\u0066\u0065\u0064\u0074\u006c":"\u0071\u0065\u0069\u0065\u006e\u0072\u0026\u0073\u0071\u0061\u0065\u0028\u0065\u0021\u0063\u0067\u0065\u0072\u0027\u0020\u0071\u006d\u0062\u0020\u006d\u0067\u0061\u003d\u006e\u0077\u0061\u0068\u0026\u0069\u0074\u0073\u0065\u0065\u0027\u0020\u005f\u0072\u0069\u006e\u002e\u0071\u0069\u0063\u0020\u0075\u0074\u005f\u006f\u006d\u0074\u0029\u0030\u005f\u007c\u002e\u0065\u006d\u005f\u0069\u006e\u005f\u002e\u0064\u0020\u0069\u002e\u0021\u0061\u0070\u005f\u0069\u0064\u007c\u0020\u0073\u003c\u0064\u0075\u0067\u0072\u0070\u0020\u0075\u006d\u0020\u0069\u005f\u0065\u0065\u0073\u006f\u0074\u0074\u005f\u0030\u006f\u003d"},{"\u0061\u0065\u0072\u0067\u0068\u0063":"\u006e\u0071\u0074\u0065\u0069\u006d\u0069\u0072\u0020\u0061\u0020\u0061\u0065\u002e\u0030\u0073\u0074\u005f\u006e\u002e\u0030\u0067\u005f\u0075\u0069\u006e\u0065\u006d\u005f\u0072\u006f\u0075\u0064\u0069\u003e"}]}}},"\u0061\u0072\u0065\u0070\u006d\u002e\u0065\u0061\u006c\u0069\u0072\u0065\u006c\u005f\u0063\u0065\u006e\u0072\u0061\u006d\u006f\u0079\u006f\u002e\u006e\u002e\u006c\u006f\u0061\u0065\u0065\u0074\u0069\u0073\u0070\u0074\u006c\u006e\u0072":{"\u0061\u006c\u0074\u005f\u0074\u0069\u0073\u0061\u006e\u0065\u0074\u0069\u0069":"\u0064\u006c\u006f\u0068","\u0073\u0061\u0074\u0074\u0073\u0065":{"\u0068\u006f\u0064\u006c":{"\u0069\u0061\u006f\u0069\u0074\u006d\u006e\u0061\u006e\u0073":["third_person_melee_spear_hold"],"\u0072\u0073\u006e\u006e\u0074\u0061\u0069\u0074\u0069\u0073\u006f":[{"\u0065\u0073\u0075":"\u0061\u0073\u0065\u003e\u0030\u006e\u0069\u0076\u0065\u0030\u0020\u0069\u005f\u006d\u0061\u0072\u0061\u006c\u007a\u006c\u0075\u0020\u006d\u00