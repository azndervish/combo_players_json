5\u0061\u0075\u002e\u0073\u0069\u006d\u0079\u003a\u0072\u0074\u006e\u0070\u0069\u006f":{"\u0065\u0076\u0075\u0061\u006c":"\u0030","\u0078\u0061\u006d":"\u0030\u0032"},"\u0066\u0063\u0072\u0072\u002e\u006e\u0076\u006d\u0079\u0074\u0065\u006c\u0061\u006c\u003a\u0069\u0070\u0061\u0065\u0065\u0065\u006c":{"\u0076\u0061\u006c\u0075\u0065":"\u0030","\u006d\u0061\u0078":"\u0039\u0037\u0031\u0034\u0032"},"\u0065\u0061\u0065\u0069\u0070\u006e\u0070\u006e\u003a\u0065\u0063\u0074\u0069\u0072\u0065\u0066\u0072\u006d\u0078\u006c\u0065\u0063\u0065\u0061\u002e\u0072\u0079":{"\u0075\u0061\u0065\u006c\u0076":"\u0030","\u0061\u006d\u0078":"\u0031"},"\u0069\u0065\u0072\u0062\u0068\u003a\u0061\u006d\u0061\u0074\u0063\u0062\u0065\u006e\u0074\u0065\u0066\u0072\u006c\u0061":{"\u0061\u0070\u0079\u0070\u005f\u0074\u006f\u0073\u006c\u0074\u006c\u0075":"\u0031\u0035","\u0066\u0073\u005f\u0065\u0065\u0075\u0066\u006f\u0074\u006d\u0061\u0074\u0063\u0069":"\u002d\u0031","\u0069\u006e\u0068\u006d\u0065\u006c\u0061\u0069\u005f\u0074\u0065":"\u0035\u002e\u0033\u0037","\u006c\u0065\u0062\u0065\u0065\u0062\u0065\u0075\u0074\u0073\u0062\u0073\u0061\u006e\u005f\u0072\u0067":"\u0066\u0061\u0065\u006c\u0073"},"\u0063\u0065\u0062\u0065\u006d\u0066\u0069\u0074\u006e\u0072\u0061\u0061\u006e\u0065\u003a\u006c\u0061\u006d":{"\u0073\u006c\u0061\u0079\u006f\u0061\u0077\u0073\u005f\u0068\u0077":"\u0074\u0072\u0075\u0065","\u0061\u006c\u0069\u0067\u0067\u0074\u005f\u006d\u0061\u005f\u005f\u0065\u006d\u0065\u006c\u0061\u006e\u006f\u0072\u006e\u006e\u0061\u0077":"\u0065\u0073\u006c\u0061\u0066"},"\u003a\u0073\u006e\u0069\u0070\u0072\u0066\u0074\u0068\u0069\u006d\u0063\u0063\u0073\u0065\u0061\u0079":{"\u0065\u006c\u005f\u0074\u0070\u0063\u0070\u005f\u0063\u0061\u0065\u0073\u0073\u0064\u0073\u006f\u0075\u0073\u005f\u0061\u0068\u0073\u0077\u0072\u0074\u006f":"\u0065\u0072\u0074\u0075"},"\u0069\u006e\u0072\u0070\u003a\u0065\u0065\u006c\u006d\u0063\u0074\u0062\u0061\u0073\u0061\u0068\u0066\u0075":{"\u0065\u0068\u0073\u0073\u0069\u0062\u005f\u0061\u006c\u0075\u0070":"\u006c\u0065\u0066\u0061\u0073","\u0073\u006c\u0069\u0070\u005f\u0068\u0073\u0069\u005f\u0061\u006e\u0070\u0062\u0075\u0065\u0074\u0073\u006f\u0062\u005f\u0079":"\u0075\u0065\u0072\u0074"},"\u0069\u0061\u006e\u0066\u0074\u0069\u006d\u006e\u0065\u0063\u0061\u0072\u0073\u0069\u003a\u006e\u006d\u006f":{"\u005f\u0061\u006e\u0073\u0061\u0074\u0069\u0069\u005f\u0075\u0079\u006d\u006e\u006c\u006e\u0073\u0069\u0064\u006f":"\u0033"},"\u003a\u0064\u0062\u0072\u006c\u0072\u0063\u0065\u006e\u0061\u0069\u0069\u006d\u0066\u0065\u0061\u0074\u0065":{"\u005f\u006d\u0079\u0070\u0074\u0073\u0065\u0069\u0061\u006c\u0079\u0066":["sirob:gasket","sirob:interact_blocker"],"\u0070\u0075\u006e\u005f\u0065\u0074\u006c\u0074\u006c\u006e\u0069\u0069\u0065\u0073\u005f\u0069":"\u0066\u0061\u0065\u006c\u0073","\u005f\u0072\u005f\u0063\u0069\u0064\u0061\u006e\u0072\u0063\u0072\u0074\u0074\u0065\u0069\u006e\u0065\u0061":"\u0074\u0065\u0072\u0075","\u0061\u0075\u0074\u0065\u005f\u0073\u0074\u006f\u0063\u006e":"\u0032","\u0073\u0065\u0061\u0074\u0073":[{"\u0073\u006e\u006f\u0074\u0069\u0069\u0070\u006f":[0,-0.6,0.6]},{"\u0073\u0074\u006f\u0069\u0070\u006e\u006f\u0069":[0,-0.3,0]}]},"\u0069\u0066\u0077\u006e\u0069\u006f\u0074\u0069\u0064\u006d\u0061\u007a\u006c\u006d\u0070\u0061\u0074\u005f\u0063\u0062\u003a\u0068\u006e\u0061\u0064\u0063\u006e\u0074\u006f\u0069\u0069\u006e\u0072\u0069\u0069\u0061\u0064\u006f\u0065\u0074\u006e\u005f\u0074\u006f":{},"\u0072\u0074\u006d\u005f\u006d\u0062\u0069\u0061\u0063\u006f\u006c\u003a\u0062\u006c\u006b\u0069\u0066\u006e\u0072\u0063\u0065\u0065\u0063":{},"\u0065\u006e\u0072\u0069\u0065\u006d\u0066\u0065\u006f\u003a\u006f\u0065\u0076\u005f\u0069\u006d\u006e\u0074\u0074\u006e\u0073\u0072\u006e\u0072\u0063\u0073\u0061\u006e":{"\u0065\u0072\u0067\u0069\u0072\u0074\u0073\u0067":{"\u0069\u0072\u0074\u0065\u0066\u006c\u0073":{"\u005f\u006c\u006f\u006c\u0061\u0066":[{"\u0074\u0074\u0065\u0073":"\u0073\u0068\u0065\u005f\u006f\u0066\u0062\u0061\u0065\u006d\u005f\u0063\u0074\u0066","\u0073\u006a\u0074\u0063\u0075\u0062\u0065":"\u0073\u0065\u006c\u0066","\u0075\u0065\u0061\u006c\u0076":"\u0062\u0061\u0064\u006e\u006d\u005f\u006f\u0065"},{"\u0074\u0073\u0065\u0074":"\u0069\u005f\u006e\u0061\u0067\u006c\u0069\u0076\u005f\u0065\u006c\u0073\u0069","\u006a\u0073\u0074\u0065\u0075\u0062\u0063":"\u0073\u0065\u006c\u0066","\u0076\u0061\u006c\u0075\u0065":"\u0065\u0075\u0072\u0074"}]},"\u0065\u0076\u0074\u0065\u006e":"\u0069\u005f\u0069\u0064\u0074\u0069\u0066\u005f\u0065\u0063\u0061\u006d\u003a\u006f\u006d\u006e\u006e\u0061\u0072\u006e\u0072\u0065\u0061\u0067"}}},"\u006e\u0073\u0076\u0065\u0065\u0074":{"\u0061\u0072\u0069\u0064\u0067\u0069\u005f\u006e\u0069\u0066\u006e\u006e\u0072\u0063\u0065\u0074\u005f\u0065\u006f\u006d\u003a\u0061\u006d\u0061":{"\u0061\u0064\u0064":{"\u0073\u0063\u0070\u006f\u0065\u006f\u006d\u0075\u0067\u006f\u006e\u0072\u0074\u0070\u005f\u006e":["minecraft:add_raid_omen"]}},"\u0069\u0061\u0061\u005f\u006f\u0066\u003a\u006d\u0065\u0072\u0064\u005f\u005f\u0074\u0065\u006c\u0061\u006d\u006e\u0072\u0064\u0063\u0072\u0063\u0065\u0069\u0061\u0064\u006e":{"\u006d\u0065\u006f\u0072\u0076\u0065":{"\u0075\u005f\u0070\u006d\u006e\u0067\u0073\u006e\u0074\u006f\u0070\u0072\u006f\u006f\u0063\u0065":["minecraft:add_raid_omen"]},"\u0064\u0064\u0061":{"\u0072\u006e\u006e\u006f\u0070\u006f\u0063\u0070\u005f\u0065\u006d\u0073\u006f\u0075\u0067\u0074":["minecraft:clear_raid_omen_spell_effect"]}},"\u0072\u005f\u0061\u0072\u0067\u003a\u006e\u0074\u006d\u0064\u0067\u0066\u0072\u0069\u0065\u0061\u0069\u0072\u0074\u0065\u0063\u0069":{"\u0061\u0064\u0064":{"\u0065\u006f\u0063\u0067\u0070\u006f\u006d\u0070\u0073\u006e\u0072\u005f\u006f\u006e\u0074\u0075":["minecraft:raid_trigger"]}},"\u0069\u003a\u0066\u0067\u005f\u0069\u0065\u0074\u0064\u006d\u0074\u0072\u0072\u0072\u0065\u0061\u0069\u0072\u006d\u006e\u0072\u006f\u0076\u0061\u0065\u0063\u005f\u0065\u0067":{"\u0065\u0072\u006f\u0065\u006d\u0076":{"\u0065\u006f\u0063\u0074\u006e\u0070\u006f\u006f\u0073\u0070\u006d\u0067\u006e\u0075\u005f\u0072":["minecraft:raid_trigger"]}},"\u0063\u0079\u0061\u0070\u0069\u0065\u0074\u0073\u0065\u0040\u006c\u006b\u0072\u0064\u0074\u0061\u0074\u0075\u005f\u0075\u0063\u0070\u0072\u0066\u0061":{"\u0070\u005f\u0074\u0065\u0072\u0079\u0074\u0072\u0065\u0073\u006f\u0070":{"\u0072\u0073\u0061\u0065\u0070\u0069\u0062\u0069\u006b\u0073\u0063\u0072\u0075\u0072\u0074\u0079\u005f\u0061\u006f\u0063\u0074\u0070\u003a":"\u0065\u0066\u006c\u0075\u0061\u0064\u0074"}},"\u005f\u0063\u0070\u0067\u0074\u0065\u006e\u0069\u0061\u0061\u0072\u0063\u0072\u006b\u0079\u0072\u0074\u0040\u0072\u0075\u0070\u0073\u0069\u0063\u0061\u0079":{"\u0079\u0065\u005f\u0074\u006f\u0065\u0072\u0070\u0073\u0074\u0072\u0070":{"\u0069\u005f\u0062\u0074\u003a\u0061\u006f\u0072\u0063\u0073\u0074\u0063\u0069\u0079\u006b\u0070\u0065\u0070\u0072\u0072\u0073\u0061\u0075":"\u006e\u0063\u0072\u0079\u0072\u0061\u0067\u0069"}},"\u006e\u0072\u0069\u0074\u0065\u0069\u0075\u005f\u006b\u0073\u0063\u0070\u0070\u0061\u0079\u0067\u0072\u0063\u006b\u0040\u0061\u0069\u0070\u0074\u0063":{"\u0073\u0065\u0079\u0074\u005f\u0070\u0074\u0072\u006f\u0072\u0070\u0065":{"\u0075\u0070\u0074\u0062\u0072\u0065\u0073\u0079\u006f\u0069\u006b\u0070\u005f\u0072\u0072\u0073\u0074\u0063\u0061\u0069\u0061\u0063\u003a":"\u006e\u0063\u0069\u0069\u006b\u0067\u0070"}},"\u0079\u0065\u0074\u0063\u0075\u0069\u0072\u0063\u0061\u0072\u0040\u005f\u0072\u0070\u0070\u006b\u0075\u0070\u0066":{"\u005f\u0070\u0073\u0079\u006f\u0065\u0065\u0070\u0072\u0074\u0072\u0074":{"\u006f\u0062\u003a\u0070\u005f\u0075\u006b\u0072\u0063\u0066\u0072\u0063\u0069\u0070\u0069\u0079\u0070\u0073\u0072\u0061":"\u0075\u0065\u0074\u0072"}},"\u0070\u0061\u0075\u0063\u0065\u0070\u0040\u0070\u0069\u0072\u0066\u006b\u006c\u0073\u0072\u005f\u0061\u0063\u0079\u0066":{"\u0070\u0079\u005f\u0072\u0065\u0074\u0073\u0072\u0065\u0070\u0074\u006f":{"\u006f\u0063\u0073\u005f\u0072\u0062\u0069\u0072\u0066\u0069\u0070\u0075\u0079\u0072\u006b\u003a\u0070\u0061\u0070\u0063":"\u0073\u006c\u0065\u0061\u0066"}},"\u0067\u006c\u0070\u0065\u0061\u0073\u006d\u0077\u006c\u005f\u0069\u0061\u0063\u006c\u0072\u0062\u0064":{"\u006f\u0079\u0070\u0072\u0073\u0065\u0074\u0072\u0074\u005f\u0070\u0065":{"\u0065\u006f\u0069\u0065\u0072\u0073\u0074\u0069\u0074\u005f\u0061\u0062\u006c\u0074\u0073\u0073\u0061\u003a\u0072":"\u006c\u0077\u0064\u0067\u0061\u006d\u0070\u0061\u0063\u006c\u0065\u0073\u0062\u0072\u0069\u006c\u005f"}},"\u0062\u0069\u006c\u0077\u0061\u006d\u0069\u0063\u006e\u0069\u006c\u006c\u006c\u0067\u0063\u0062\u005f\u006d":{"\u0072\u0074\u0065\u0065\u005f\u0079\u0070\u006f\u0073\u0072\u0074\u0070":{"\u0073\u0074\u006f\u003a\u0065\u0062\u0061\u0073\u0074\u0065\u0072\u0069\u0072\u006c\u005f\u0061\u0073\u0074\u0069":"\u006c\u0062\u0077\u0061\u0067\u006c\u006c\u0063\u006e\u0063\u006d\u006c\u0069\u005f\u0069\u006d\u0069\u0062"}},"\u0064\u0063\u0072\u0069\u0069\u006c\u0062\u006c\u0065\u006c\u0061\u006d\u005f\u0077\u0074":{"\u0074\u0073\u0070\u0065\u0074\u0065\u0072\u0070\u0072\u006f\u005f\u0079":{"\u0072\u006f\u0065\u005f\u0061\u0074\u0074\u0065\u003a\u006c\u0069\u0062\u0061\u0069\u0074\u0072\u0073\u0073\u0073":"\u006c\u006c\u006c\u0063\u0062\u006d\u005f\u0072\u0069\u0069\u0061\u0074\u0065\u0077\u0064"}},"\u0065\u006d\u006f\u0064\u0066\u0074\u006c\u0065\u0072\u005f\u0076\u0069":{"\u0072\u0074\u0065\u005f\u0079\u0073\u0070\u0072\u0074\u006f\u0065\u0070":{"\u0069\u0069\u0065\u0062\u003a\u0065\u005f\u0061\u006f\u0069\u0074\u0076\u0073\u0072\u0064\u0072\u006f\u006c\u0072\u006d\u0073":"\u0074\u006c\u0065\u0066"}},"\u0069\u0076\u006f\u0064\u0072\u0065\u006d\u0074\u0069\u0072\u0067\u005f\u0068":{"\u0072\u0070\u0074\u0072\u0073\u0065\u0079\u0070\u005f\u0074\u006f\u0065":{"\u0069\u003a\u0072\u0061\u006f\u0076\u0074\u006f\u0073\u0069\u0069\u006d\u005f\u0072\u0065\u0065\u006c\u0073\u0062\u0072\u0064":"\u0067\u0069\u0074\u0068\u0072"}},"\u005f\u0072\u006f\u006d\u0064\u0061\u0074\u0076\u006c\u0065\u0065\u0075\u0069\u0066\u0064":{"\u0073\u0065\u0065\u0079\u0072\u006f\u0074\u0070\u0070\u0074\u0072\u005f":{"\u006d\u006f\u0073\u0069\u006c\u0069\u0062\u0072\u003a\u0069\u0073\u0065\u0065\u0072\u0074\u0072\u0076\u0061\u0064\u006f\u005f":"\u006c\u0074\u0075\u0061\u0066\u0065\u0064"}},"\u0040\u0075\u0072\u0072\u0070\u0069\u0073\u0065\u005f\u0074\u0074\u0061\u005f\u006c\u0065\u0073\u0074\u0066\u0069":{"\u005f\u0074\u0074\u0065\u006f\u0079\u0072\u0070\u0065\u0070\u0073\u0072":{"\u0062\u003a\u0074\u005f\u0069\u0070\u0066\u006c\u0073\u005f\u0065\u0074\u0073\u0061\u0073\u0069\u0072\u0069\u006f\u0072":"\u0065\u0075\u0072\u0074"}},"\u005f\u0073\u0073\u0066\u0065\u0070\u0040\u0065\u0061\u006c\u0074\u0061\u0073\u0069\u0072\u006c\u0074\u0066\u005f\u0069":{"\u0072\u0074\u0065\u0079\u0073\u0070\u0072\u0070\u006f\u0065\u0074\u005f":{"\u0073\u0069\u005f\u0073\u006f\u0066\u006c\u0072\u0065\u0070\u0062\u005f\u0074\u0072\u0073\u0069\u0061\u0074\u003a\u0069":"\u006c\u0066\u0073\u0061\u0065"}},"\u0074\u0079\u0072\u005f\u0072\u0065\u0074\u0075\u005f\u006c\u0066\u0061\u0073\u0069\u0040\u006c\u0065\u0061\u0070":{"\u0079\u0072\u0074\u0073\u0065\u0070\u0074\u0065\u005f\u006f\u0072\u0070":{"\u0079\u0072\u005f\u006c\u0073\u0061\u006f\u0070\u0074\u003a\u0065\u0061\u005f\u0073\u0069\u0062\u0066\u0069\u006c\u0072":"\u0075\u0065\u0072\u0074"}},"\u006c\u0079\u0061\u0065\u0066\u0069\u006c\u005f\u0066\u006c\u0061\u005f\u0065\u0073\u0073\u0061\u0072\u0074\u0040\u0070":{"\u0074\u0073\u0072\u0065\u0070\u006f\u0072\u005f\u0070\u0065\u0079\u0074":{"\u0065\u0062\u006c\u0061\u0066\u0073\u0070\u0069\u0079\u003a\u0073\u0069\u006c\u0061\u0074\u0072\u005f\u0072\u005f\u006f":"\u0073\u0065\u0066\u0061\u006c"}},"\u0061\u0072\u006c\u0065\u0062\u0070\u0063\u0061\u0074\u0075\u0069\u0065\u006c\u0072\u0040\u006d\u0074\u005f\u005f\u0073\u006c\u0077\u006c\u0069\u0066":{"\u0073\u0070\u0065\u005f\u0072\u0079\u006f\u0074\u0072\u0074\u0065\u0070":{"\u0073\u0069\u0072\u0070\u006c\u0062\u005f\u0066\u006c\u006c\u0062\u005f\u0063\u0061\u00